  "cards": [
    {
      "dot": "emerald",
      "title": "Decoupled Dashboards",
      "items": [
        "FastAPI serves queries solely from pre-aggregated rollups in Rollup DB",
        "Zero dashboard query load touches the primary OLTP database",
        "Target p95 latency under 100ms across 10M orders and 100 tenants"
      ]
    },
    {
      "dot": "cyan",
      "title": "CDC Pipeline",
      "items": [
        "Statement-level AFTER triggers write signed diff rows (+1 / -1) with xid8",
        "Worker uses pg_snapshot_xmin safe watermark to prevent missed commits",
        "In-memory aggregation folds multi-item batches into a single upsert per key"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety & Integrity",
      "items": [
        "Strict tenant isolation with mandatory X-Tenant-Key authentication",
        "CHECK (count >= 0) enforces fail-closed behavior on calculation errors",
        "Corrupted records routed directly to quarantine with failure reason"
      ]
    }
  ]
