        "focus": ["mainapp", "db_1", "db_2", "db_n", "outbox", "worker", "rollupdb"],
        "note": "Triggers early-filter writes and emit signed diffs. The worker multiplexes 100 tenant sockets with 0ms idle polling overhead."
      },
      {
        "id": "sse-stream-path",
        "label": "Real-Time SSE Streaming",
        "focus": ["worker", "rollupdb", "api", "dashboards"],
        "note": "Rollup changes fire NOTIFY to FastAPI, pushing live updates to dashboards via Server-Sent Events (SSE) within 40ms of commit."
      },
      {
        "id": "rebuild-admin",
        "label": "Zero-Downtime Rebuild & Isolation",
        "focus": ["api", "worker", "rollupdb", "quarantine"],
        "note": "Admin endpoint initiates worker rebuild into shadow rollups with atomic swap. Corrupted rows are isolated in quarantine."
      }
    ]
