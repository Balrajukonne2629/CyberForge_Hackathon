  "cards": [
    {
      "dot": "emerald",
      "title": "Event CDC Pipeline",
      "items": [
        "Statement triggers filter writes and emit signed diffs (+1 / -1) with xid8",
        "PostgreSQL LISTEN/NOTIFY and selectors eliminate 200ms idle polling",
        "Deficit Round-Robin (DRR) fairness prevents tenant starvation"
      ]
    },
    {
      "dot": "cyan",
      "title": "Central Rollup & SSE",
      "items": [
        "Central DB maintains hourly order status and daily product rollups",
        "FastAPI streams live metrics via Server-Sent Events (SSE) in <40ms",
        "Fail-closed CHECK (count >= 0) isolates corrupt state to quarantine"
      ]
    },
    {
      "dot": "rose",
      "title": "Isolation & Throttle",
      "items": [
        "100 isolated PostgreSQL tenant DBs enforce strict blast containment",
        "Per-tenant semaphore limit (32 concurrent, 1.0s timeout) protects API",
        "Sub-10ms analytical p95 latency with zero contention on OLTP"
      ]
    }
  ]
