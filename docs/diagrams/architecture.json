        "note": "Tenant dashboards query central rollups via FastAPI in sub-10ms p95. Zero analytical load touches tenant OLTP databases."
      },
      {
        "id": "event-cdc-path",
        "label": "Event-Driven CDC Ingestion",
        "focus": [
          "mainapp",
          "db_1",
          "outbox_1",
          "db_n",
          "outbox_n",
          "worker",
          "rollupdb"
        ],
        "note": "Mutations to tenant DBs emit signed diffs into each local outbox table; worker multiplexes 100 tenant sockets via LISTEN/NOTIFY."
      },
      {
        "id": "sse-stream-path",
        "label": "Real-Time SSE Streaming",
        "focus": [
          "worker",
          "rollupdb",
          "api",
          "dashboards"
        ],
        "note": "Rollup changes fire NOTIFY to FastAPI, pushing live updates to dashboards via Server-Sent Events (SSE) within 40ms of commit."
      },
      {
        "id": "rebuild-admin",
        "label": "Zero-Downtime Rebuild & Isolation",
        "focus": [
          "api",
          "worker",
          "rollupdb",
          "quarantine"
        ],
        "note": "Admin endpoint initiates worker rebuild into shadow rollups with atomic swap. Corrupted rows are isolated in quarantine."
      }
    ]
