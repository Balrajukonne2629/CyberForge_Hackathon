    "views": [
      {
        "id": "ingest-pipeline",
        "label": "Event-Driven CDC Pipeline",
        "focus": ["client_app", "simulator", "main_oltp", "outbox_log", "worker_engine", "rollup_orders", "rollup_products"],
        "note": "Mutations to tenant DBs emit signed diffs via triggers; worker multiplexes 100 tenant sockets and folds in memory."
      },
      {
        "id": "serving-pipeline",
        "label": "Analytical Serving & Live SSE",
        "focus": ["rollup_orders", "rollup_products", "fastapi_gateway", "store_dashboards"],
        "note": "Rollup updates trigger SSE pushes to dashboards; analytical queries are served sub-10ms without touching tenant DBs."
      },
      {
        "id": "quarantine-pipeline",
        "label": "Quarantine & Safety Guard",
        "focus": ["worker_engine", "quarantine_store"],
        "note": "Violating or malformed rows are isolated into quarantine without blocking the CDC pipeline or corrupting rollups."
      }
    ]
  },
