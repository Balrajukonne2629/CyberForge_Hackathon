  "cards": [
    {
      "dot": "emerald",
      "title": "Event CDC Ingest",
      "items": [
        "Statement triggers filter writes and emit signed diffs (+1 / -1) with xid8",
        "PostgreSQL LISTEN/NOTIFY and selectors eliminate 200ms idle polling",
        "Deficit Round-Robin (DRR) fairness prevents tenant starvation"
      ]
    },
    {
      "dot": "cyan",
      "title": "In-Memory Rollups",
      "items": [
        "CDC worker folds batch records in memory into a single upsert per bucket",
        "Rollups maintain hourly orders and daily product sales with check constraints",
        "Malformed or violating rows isolate safely into quarantine"
      ]
    },
    {
      "dot": "rose",
      "title": "Serving & Live SSE",
      "items": [
        "FastAPI enforces tenant isolation and 32-concurrency limits",
        "Rollup changes fire NOTIFY, streaming live SSE updates in <40ms",
        "Analytical queries achieve p95 < 10ms with zero OLTP contention"
      ]
    }
  ]
